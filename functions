# shellcheck shell=bash
# shellcheck disable=SC2154  # variables are provided by the sourcing script
#
# functions -- helpers shared by the pincram scripts
#
# Sourced after the including script has set $pn (its own name) and defined usage().

msg () {
    local msgline
    for msgline ; do echo "$pn: $msgline" >&2 ; done
}

fatal () { usage ; msg "$@" ; exit 1 ; }

# tempdir : create a uniquely named directory under $TMPDIR/$USER and print its path
tempdir () {
    local base=${TMPDIR:-/tmp}/$USER
    mkdir -p "$base" || fatal "Could not create $base"
    mktemp -d "$base/$(basename "$0").XXXXXX" || fatal "Could not create temp dir in $base"
}
