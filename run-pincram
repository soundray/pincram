#!/usr/bin/env bash
#
# run-pincram -- sample launcher. Copy, adapt the settings and run: run-pincram t1.nii.gz
#
# For the full list of options and environment variables, call pincram.sh without arguments.

#####
# Execution: where the atlas-target registrations run
#####

export PINCRAM_ARCH=local            # all on this machine, up to -par registrations at a time
# export PINCRAM_ARCH=slurm          # one Slurm job array per level; the driver may run on a login node
# export PINCRAM_SLURM_OPTS="-A myaccount -p mypartition"   # added to every sbatch call
# export PINCRAM_SLURM_MEM="4G 4G 8G"                        # memory per registration, per level
# export PINCRAM_SLURM_TIME="30 30 120"                      # minutes per registration, per level

#####
# Registration library: mirtk (recommended) or greedy (experimental)
#####

export PINCRAM_USE_LIB=mirtk

#####
# Robustness
#####

export PINCRAM_PROCEED_PCT=100       # % of selected atlases that must register successfully per level.
                                     # Lower for rapid testing or when the cluster is unreliable.
export PINCRAM_MAX_ATTEMPTS=3        # Attempts per registration (memory/time doubled after OOM/timeout)

#####
# Search path
#####

base_sw_path=$HOME/software

PATH=$base_sw_path/pincram:$PATH                     # Required -- this directory
PATH=$base_sw_path/niftyseg/build/seg-apps:$PATH     # Required -- https://github.com/KCL-BMEIS/NiftySeg
PATH=$base_sw_path/mirtk/install/bin:$PATH           # Required -- https://github.com/BioMedIA/MIRTK
# PATH=$base_sw_path/greedy/build:$PATH              # Optional -- https://github.com/pyushkevich/greedy
export PATH

#####
# Call pincram
#####

pincram.sh "$1" -result result -atlas atlas -threads 1
